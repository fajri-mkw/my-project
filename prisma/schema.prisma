// Prisma Schema - Pushakin Flows - Media Workflow Management System
// Provider is auto-detected: SQLite for local (file: URL), PostgreSQL for Vercel (postgres: URL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url       = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  password          String   @default("$2a$10$placeholder")
  whatsapp          String?
  avatar            String?
  role              String   @default("Reporter")
  notifWaEnabled    Boolean  @default(true)
  notifEmailEnabled Boolean  @default(true)
  autoApproveReview Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tasksAsAssignee   Task[]
  notifications     Notification[]
  projectsAsManager Project[]
  suratTugas        SuratTugas[]
  sops              SOP[]

  @@index([role])
  @@map("users")
}

model Project {
  id              String   @id @default(cuid())
  title           String
  description     String
  requesterUnit   String
  location        String?
  executionTime   String?
  picName         String?
  picWhatsApp     String?
  activityTypes   String
  customActivity  String?
  outputNeeds     String
  customOutput    String?
  workerOutputs     String?  @default("{}")
  workerCustomOutput String? @default("{}")
  currentStage      Int      @default(1)
  isFastTrack       Boolean  @default(false)
  isFastProduction  Boolean  @default(false)
  // Fitur khusus Tahap 2 (Pasca Produksi) — manager bisa memilih saat inisiasi:
  // - enableFotoEditor: aktifkan task Editor (Foto)
  // - enableTemplateEditor: aktifkan task Editor (Template Sosial Media)
  // Jika salah satu false, task untuk role tersebut TIDAK dibuat saat inisiasi,
  // dan dependency intra-stage menyesuaikan (ETSM tidak perlu nunggu EFoto jika EFoto tidak ada).
  enableFotoEditor      Boolean  @default(true)
  enableTemplateEditor  Boolean  @default(true)
  managerId         String
  publicToken     String?  @unique
  documents       String?  @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  manager      User           @relation(fields: [managerId], references: [id], onDelete: Cascade)
  tasks        Task[]
  driveFolders DriveFolder[]
  notifications Notification[]
  suratTugas   SuratTugas[]

  @@index([managerId])
  @@index([currentStage])
  @@index([createdAt])
  @@map("projects")
}

model Task {
  id          String   @id @default(cuid())
  role        String
  stage       Int
  status        String   @default("pending")
  data          String?
  revisionCount Int      @default(0)
  assignedTo    String
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User    @relation(fields: [assignedTo], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assignedTo])
  @@index([stage])
  @@index([status])
  // Composite index for the project-repair query:
  //   WHERE projectId = ? AND status != 'completed'
  // Single-column indexes (projectId, status) require scanning all rows
  // for one predicate then filtering by the other. The composite lets D1
  // seek directly to the matching rows in one index lookup — critical for
  // the auto-repair query that runs on every Admin/Manager dashboard load.
  @@index([projectId, status])
  @@map("tasks")
}

model DriveFolder {
  id             String  @id @default(cuid())
  folderId       String
  name           String
  description    String?
  link           String?
  assignedRoles  String?
  assignedUsers  String?
  color          String?
  bgColor        String?
  borderColor    String?
  projectId      String
  parentFolderId String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("drive_folders")
}

model Notification {
  id         String   @id @default(cuid())
  message    String
  projectId  String?
  targetView String   @default("project_detail")
  read       Boolean  @default(false)
  userId     String
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([read])
  @@map("notifications")
}

model SuratTugas {
  id         String   @id @default(cuid())
  nomorSurat String   @unique
  projectId  String
  userId     String
  role       String
  stage      Int
  status     String   @default("active")
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@map("surat_tugas")
}

model Settings {
  id                    String   @id @default("main")
  driveAutoCreate       Boolean  @default(false)
  driveMode             String?  // 'shared' (default) | 'folder' — selects Shared Drive mode vs My Drive folder mode
  driveParentFolderId   String?
  driveSharedDriveId    String?
  driveFolderId         String?  // My Drive folder ID used when driveMode = 'folder'
  driveServiceAccountKey String?
  driveApiKey           String?
  maintenanceMode       Boolean  @default(false)
  maintenanceMessage    String?
  notifWaEnabled        Boolean  @default(false)
  notifWaToken          String?
  notifWaDeviceId       String?
  notifWaSenderNumber   String?
  notifEmailEnabled     Boolean  @default(false)
  notifEmailHost        String?
  notifEmailPort        Int?
  notifEmailUser        String?
  notifEmailPass        String?
  notifEmailFromName    String?
  updatedAt             DateTime @updatedAt

  @@map("settings")
}

model SOP {
  id             String   @id @default(cuid())
  title          String
  content        String
  type           String   @default("SOP")
  displayMode    String   @default("text")
  files          String?
  slideshowSpeed Int      @default(5000)
  published      Boolean  @default(false)
  order          Int      @default(0)
  authorId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([type])
  @@index([published])
  @@map("sops")
}

model Permohonan {
  id              String   @id @default(cuid())
  title           String
  description     String
  requesterUnit   String
  location        String?
  executionTime   String?
  picName         String?
  picWhatsApp     String?
  activityTypes   String   @default("[]")
  customActivity  String?
  outputNeeds     String   @default("[]")
  customOutput    String?
  status          String   @default("pending")
  adminNote       String?
  documents       String?  @default("[]")
  administratorId String?
  managerId       String?
  projectId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([administratorId])
  @@index([managerId])
  @@index([status])
  @@map("permohonan")
}

model Surat {
  id              String    @id @default(cuid())
  nomorSurat      String
  jenisSurat      String
  kategori        String
  tanggalSurat    DateTime?
  pengirim        String?
  penerima        String?
  perihal         String
  deskripsi       String?
  status          String    @default("diterima")
  catatan         String?
  documents       String?   @default("[]")
  driveFolderId   String?
  driveFolderLink String?
  location        String?
  executionTime   String?
  picName         String?
  picWhatsApp     String?
  administratorId String?
  managerId       String?
  projectId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([administratorId])
  @@index([managerId])
  @@index([status])
  @@index([kategori])
  @@map("surat")
}

model ProgramKegiatan {
  id              String    @id @default(cuid())
  nomorKegiatan   String
  jenisKegiatan   String    @default("Kegiatan")
  kategori        String    @default("Umum")
  tanggalKegiatan DateTime?
  penyelenggara   String?
  perihal         String    @map("namaKegiatan")
  deskripsi       String?
  status          String    @default("direncanakan")
  catatan         String?
  documents       String?   @default("[]")
  driveFolderId   String?
  driveFolderLink String?
  location        String?
  executionTime   String?
  picName         String?
  picWhatsApp     String?
  managerId       String?
  projectId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([managerId])
  @@index([status])
  @@index([kategori])
  @@map("program_kegiatan")
}

// External App Links — managed by Super Admin, shown in left sidebar for all users.
// Clicking a link opens it in a new browser tab.
// Examples: online gallery, photo editor, video editor, asset library, etc.
model ExternalLink {
  id          String   @id @default(cuid())
  label       String   // Display name shown in sidebar
  url         String   // External URL (must include http:// or https://)
  icon        String?  // Optional Lucide icon name (defaults to "ExternalLink")
  description String?  // Optional admin-facing description (not shown in sidebar)
  isActive    Boolean  @default(true) // Only active links are shown to users
  order       Int      @default(0)    // Lower numbers appear first
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("external_links")
}

// ============================================================================
// MANAJEMEN INVENTARIS HUMAS — Super Admin only
// Sistem manajemen barang humas (merchandise, brosur, hadiah, dll.) dengan
// peminjaman, pengembalian, pembagian, history, dan rekapitulasi.
// ============================================================================

model Inventory {
  id              String   @id @default(cuid())
  kodeBarang      String   @unique
  namaBarang      String
  kategori        String   // e.g. 'Merchandise', 'Brosur', 'Hadiah', 'ATK', 'Lainnya'
  jumlahTotal     Int      @default(0)
  jumlahTersedia  Int      @default(0)
  jumlahDipinjam  Int      @default(0)
  jumlahDibagikan Int      @default(0)
  lokasi          String?
  pengguna        String?
  penanggungJawab String?
  sumberPengadaan String?  // 'Umum' | 'Mandiri'
  tahunPengadaan  Int?
  status          String   @default("baik") // 'baik' | 'rusak' | 'hilang'
  kondisiCatatan  String?  // catatan kondisi (mis. "handle rusak", "hilang di event X")
  imageFileId     String?  // Google Drive file ID for inventory photo
  imageUrl        String?  // Drive webViewLink untuk display
  catatan         String?
  createdBy       String?  // user ID yang input
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loans           InventoryLoan[]
  distributions   InventoryDistribution[]
  histories       InventoryHistory[]

  @@index([kategori])
  @@index([status])
  @@index([createdAt])
  @@map("inventory")
}

model InventoryLoan {
  id                String   @id @default(cuid())
  inventoryId       String
  peminjamId        String?  // user ID (kalau internal) atau null (external)
  peminjamName      String   // nama peminjam (display)
  tanggalPinjam     DateTime @default(now())
  tanggalKembaliRencana DateTime?
  tanggalKembaliAktual DateTime?
  jumlahDipinjam    Int      @default(1)
  status            String   @default("pending")
                                  // 'pending' (menunggu approval)
                                  // 'approved' (disetujui, belum diambil)
                                  // 'rejected' (ditolak)
                                  // 'active' (sudah diambil, belum kembali)
                                  // 'returned' (sudah dikembalikan)
                                  // 'overdue' (lewat dari rencana kembali)
  keperluan         String?
  catatan           String?
  approverId        String?
  approvedAt        DateTime?
  rejectedReason    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  inventory       Inventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  return          InventoryReturn?

  @@index([inventoryId])
  @@index([peminjamId])
  @@index([status])
  @@index([tanggalPinjam])
  @@map("inventory_loans")
}

model InventoryReturn {
  id            String   @id @default(cuid())
  loanId        String   @unique
  tanggalKembali DateTime @default(now())
  kondisi       String   // 'baik' | 'rusak_ringan' | 'rusak_berat' | 'hilang'
  jumlahDikembalikan Int  @default(1)
  catatan       String?
  receivedById  String?  // user ID yang terima pengembalian
  createdAt     DateTime @default(now())

  loan          InventoryLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@map("inventory_returns")
}

model InventoryDistribution {
  id              String   @id @default(cuid())
  inventoryId     String
  penerimaName    String   // nama penerima (bisa internal/external)
  penerimaUnit    String?  // unit/instansi penerima
  jumlahDibagikan Int      @default(1)
  tanggalBagi     DateTime @default(now())
  keperluan       String?
  catatan         String?
  distribusiById  String?  // user ID yang melakukan pembagian
  createdAt       DateTime @default(now())

  inventory       Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([tanggalBagi])
  @@map("inventory_distributions")
}

model InventoryHistory {
  id              String   @id @default(cuid())
  inventoryId     String
  jenisTransaksi  String   // 'masuk' | 'pinjam' | 'kembali' | 'bagi' | 'edit' | 'hapus' | 'approval' | 'reject'
  tanggalTransaksi DateTime @default(now())
  pelakuId        String?  // user ID pelaku
  pelakuName      String?  // nama pelaku (display)
  keterangan      String?  // detail transaksi
  jumlah          Int?     // quantity involved (kalau relevan)
  loanId          String?  // link ke loan (kalau transaksi terkait peminjaman)
  distributionId  String?  // link ke distribution (kalau transaksi terkait pembagian)
  returnId        String?  // link ke return (kalau transaksi terkait pengembalian)

  inventory       Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([jenisTransaksi])
  @@index([tanggalTransaksi])
  @@map("inventory_history")
}
