{
  // Cloudflare Workers config for Pushakin Flows
  // Deployed via OpenNext (@opennextjs/cloudflare)
  "main": ".open-next/worker.js",
  "name": "app",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets served from OpenNext build output.
  //
  // RUN_WORKER_FIRST: only HTML routes go through the Worker (so middleware
  // can set Cache-Control headers). Static assets (/_next/static/*) bypass
  // the Worker entirely — Cloudflare serves them directly via the ASSETS
  // binding (zero Worker requests).
  //
  // Without this array, ALL assets would go through the Worker, which would
  // ADD Worker requests per asset fetch (10+ JS chunks + CSS per page load).
  // With this config:
  //   - HTML pages (/, /?view=*) → Worker (1 req per page load, cached 60s by middleware)
  //   - Static assets (/_next/static/*, *.js, *.css, *.woff2, *.svg) → ASSETS binding (0 Worker reqs)
  //
  // The negative pattern "!/_next/static/*" excludes static chunks. HTML paths
  // (which don't match the negative) fall through to the Worker.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    // Routes that should go through the Worker (everything except /_next/static/*).
    // Static assets bypass the Worker entirely — served by Cloudflare's edge
    // cache, NOT counted against the 100K/day free-plan request cap.
    "run_worker_first": ["!/_next/static/*"]
  },

  // Environment variables (set via `wrangler secret put` or dashboard)
  // DO NOT put secrets here — this file is committed to git.
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "Pushakin Flows"
  },

  // D1 database binding — used by both Prisma (via @prisma/adapter-d1) and
  // by @/lib/libsql-client.ts (via the D1 adapter wrapper) for production
  // queries on Cloudflare Workers.
  //
  // Database created via Cloudflare dashboard (Workers & Pages → D1).
  // database_id: e16468ee-3d49-40dc-99a9-b06a8436984a
  // Schema applied via: wrangler2 d1 execute pushakin-db --remote --file=scripts/d1-schema.sql
  //
  // Local dev (`bun run dev`) does NOT use this binding — it uses
  // `file:db/custom.db` via better-sqlite3 instead.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pushakin-db",
      "database_id": "e16468ee-3d49-40dc-99a9-b06a8436984a",
      "migrations_dir": "prisma/d1-migrations"
    }
  ]

  // Secrets (set via CLI):
  //   wrangler2 secret put DATABASE_URL  (still used for local file: dev,
  //   AND for production Turso fallback if D1 binding is unavailable)
  //   wrangler2 secret put DATABASE_AUTH_TOKEN  (Turso auth token, kept for
  //   legacy fallback)
  //   wrangler2 secret put DIRECT_DATABASE_URL  (not needed)
}
